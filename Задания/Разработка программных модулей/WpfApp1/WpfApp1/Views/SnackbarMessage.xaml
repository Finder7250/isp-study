<Window x:Class="TaskManagerApp.Views.SnackbarMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#FF323232" CornerRadius="6" Padding="16,10" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Trans" Y="30"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="Trans"
                                         Storyboard.TargetProperty="Y"
                                         To="0" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <TextBlock x:Name="MsgText" Foreground="White" FontSize="14"/>
    </Border>
</Window>
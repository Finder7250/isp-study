<UserControl x:Class="TaskManagerApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel Margin="20">
        <TextBlock Text="Настройки" FontSize="26" FontWeight="Bold"/>
        <materialDesign:Card Margin="0,20,0,0" Padding="16" UniformCornerRadius="8">
            <StackPanel>
                <TextBlock Text="Тема оформления" FontWeight="SemiBold" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="LightRadio" Content="Светлая" Margin="0,0,20,0"
                                 Checked="Theme_Changed" GroupName="Theme"/>
                    <RadioButton x:Name="DarkRadio" Content="Тёмная"
                                 Checked="Theme_Changed" GroupName="Theme"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </StackPanel>
</UserControl>
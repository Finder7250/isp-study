<Window x:Class="TaskManagerApp.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Задача" Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <StackPanel Margin="20">
        <TextBlock Text="Название *" FontWeight="SemiBold"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,4"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Введите название"/>
        <TextBlock x:Name="TitleError" Foreground="#E53935" FontSize="12" Margin="0,0,0,8"
                   Visibility="Collapsed" Text="Поле обязательно для заполнения"/>

        <TextBlock Text="Исполнитель" FontWeight="SemiBold"/>
        <TextBox x:Name="AssigneeBox" Margin="0,4,0,12"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="ФИО"/>

        <TextBlock Text="Приоритет" FontWeight="SemiBold"/>
        <ComboBox x:Name="PriorityBox" Margin="0,4,0,12"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <TextBlock Text="Статус" FontWeight="SemiBold"/>
        <ComboBox x:Name="StatusBox" Margin="0,4,0,12"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
            <ComboBoxItem Content="Новая"/>
            <ComboBoxItem Content="В работе"/>
            <ComboBoxItem Content="Выполнено"/>
            <ComboBoxItem Content="Просрочено"/>
        </ComboBox>

        <TextBlock Text="Срок" FontWeight="SemiBold"/>
        <DatePicker x:Name="DateBox" Margin="0,4,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Отмена" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
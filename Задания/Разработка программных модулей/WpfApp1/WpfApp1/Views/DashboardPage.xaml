<UserControl x:Class="TaskManagerApp.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Margin="10"/>
        <UniformGrid Columns="3" Margin="10">
            <materialDesign:Card Margin="8" Padding="16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Всего задач" FontSize="14" Opacity="0.7"/>
                    <TextBlock Text="{Binding Tasks.Count}" FontSize="36" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="8" Padding="16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Выполнено" FontSize="14" Opacity="0.7"/>
                    <TextBlock Text="{Binding CompletedCount}" FontSize="36" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="8" Padding="16" UniformCornerRadius="8">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                <Setter Property="Background" Value="#33E53935"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <StackPanel>
                    <TextBlock Text="Просрочено" FontSize="14" Opacity="0.7"/>
                    <TextBlock Text="{Binding OverdueCount}" FontSize="36" FontWeight="Bold"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <materialDesign:Card Margin="18" Padding="16">
            <StackPanel>
                <TextBlock Text="Последние задачи" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Просрочено">
                                                <Setter Property="Background" Value="#22E53935"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Opacity="0.7"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:Card>
    </StackPanel>
</UserControl>